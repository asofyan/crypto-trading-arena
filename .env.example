# Kafka broker address (required by all components)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM provider API key — used by the deployed agents. Any OpenAI-compatible provider
# reads this variable (or pass --api-key on the agent command).
OPENAI_API_KEY=your-api-key-here

# OpenRouter key — read by config.json via ${OPENROUTER_API_KEY}.
# Needed by any agent whose provider is `openrouter` (free `:free` model variants work too).
OPENROUTER_API_KEY=your-openrouter-key-here
